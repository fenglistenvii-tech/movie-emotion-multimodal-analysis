# ============================================================================
#  融合多模态信息的影视作品情感计算与鉴赏研究 —— Git 忽略规则
#  说明：本文件用于把「体积大 / 可重新生成 / 与源码无关」的文件挡在仓库之外。
#        被忽略的文件仍然保留在你的电脑上，只是不会被 git 提交。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 抽帧图片（数据量最大，可由 2_extract_subtitles.py 重新生成）
#    ~1654 张 4K 截图，是仓库体积的主要来源
# ---------------------------------------------------------------------------
**/frames/
frame_*.jpg

# ---------------------------------------------------------------------------
# 2. 第三方可执行文件与模型权重
#    ffmpeg.exe / ffprobe.exe 通常上百 MB，超过 GitHub 单文件 100MB 硬上限，
#    请从 https://www.gyan.dev/ffmpeg/builds/ 自行下载后放到脚本同目录。
#    （blaze_face_short_range.tflite 只有几百 KB，**保留提交**，故不在此列）
# ---------------------------------------------------------------------------
ffmpeg.exe
ffprobe.exe
*.exe
*.dll
*.zip
*.7z
*.rar

# ---------------------------------------------------------------------------
# 3. 影片（版权内容，且体积巨大，绝不入库）
#    字幕 .srt 只有一两百 KB，且是复现分析必需的输入，因此**保留提交**；
#    如果连字幕也不想上传，把下面的 !data/subtitles/ 两行删掉即可。
# ---------------------------------------------------------------------------
*.mkv
*.mp4
*.avi
*.mov
*.flv
*.wmv
*.m2ts
*.ts
*.ass
*.ssa
*.vtt
*.srt
# 例外：字幕目录整体保留（先忽略再反向排除，git 才能看到该目录）。
# 如果连字幕也不想上传，把下面两行 ! 开头的例外删掉，并在文件末尾的
# 第 10 节加上一行 data/ 即可。
!data/subtitles/
!data/subtitles/**

# ---------------------------------------------------------------------------
# 5. 运行中间产物 / 临时文件
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.log
*.tmp
*.cache
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---------------------------------------------------------------------------
# 6. Python 虚拟环境（依赖请用 requirements.txt 还原，不要提交）
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# 7. IDE / 编辑器配置（个人偏好，不入库）
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# 8. 模型运行时会自动下载的权重与缓存
#    DeepFace 首次运行会拉取 ~200MB 权重到用户目录，切勿提交
# ---------------------------------------------------------------------------
.deepface/
.deepface_weights/
*deepface*weights*
.cache/
models/

# ---------------------------------------------------------------------------
# 9. 本地私有数据与临时/备份文件
# ---------------------------------------------------------------------------
[0-9]-*.zip
[0-9]-*.rar
_*.ps1
_*.py
_backup_meta/
*.bak
*.tmp

# ---------------------------------------------------------------------------
# 10. 测试结果（results/）与论文/视频等个人答辩材料
#     仓库只放代码与说明；测试结果通过 GitHub Releases 分发，见 RELEASES.md
# ---------------------------------------------------------------------------
results/
thesis/
*.docx
*.pdf
